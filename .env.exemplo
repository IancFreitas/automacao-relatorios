# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.
# No Gmail, use uma "senha de app": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu.email@gmail.com
SMTP_SENHA=sua-senha-de-app
# Opcional: endereço que aparece como remetente (padrão: SMTP_USUARIO)
SMTP_REMETENTE=
# Separe vários destinatários por vírgula
RELATORIO_DESTINATARIOS=gestor@empresa.com,financeiro@empresa.com
